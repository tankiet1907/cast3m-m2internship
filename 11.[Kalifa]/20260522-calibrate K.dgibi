*===================================================================*
*********** STAGE: TEMPERATURE (°C & min) ***********************
*===================================================================*
* 1. Extract original data from the results table (in Kelvin units)
EVT_00_O  = EVOL 'BLEU' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_00;
EVT_10_O  = EVOL 'ORAN' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_10;
EVT_20_O  = EVOL 'JAUN' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_20;
EVT_30_O  = EVOL 'ROSE' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_30;
EVT_40_O  = EVOL 'VERT' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_40;
EVT_50_O  = EVOL 'TURQ' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_50;
EVT_120_O = EVOL 'BLAN' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_120;

* 2. Subtract 273.15 to convert to Celsius.
LY_00   = (EXTR EVT_00_O  'ORDO') - (PROG (DIME LT_MIN) * 273.15);
LY_10   = (EXTR EVT_10_O  'ORDO') - (PROG (DIME LT_MIN) * 273.15);
LY_20   = (EXTR EVT_20_O  'ORDO') - (PROG (DIME LT_MIN) * 273.15);
LY_30   = (EXTR EVT_30_O  'ORDO') - (PROG (DIME LT_MIN) * 273.15);
LY_40   = (EXTR EVT_40_O  'ORDO') - (PROG (DIME LT_MIN) * 273.15);
LY_50   = (EXTR EVT_50_O  'ORDO') - (PROG (DIME LT_MIN) * 273.15);
LY_120  = (EXTR EVT_120_O 'ORDO') - (PROG (DIME LT_MIN) * 273.15);

* 3. Redefine the Evolution curves according to the new coordinate system (min and °C)
EVT_00  = EVOL 'BLEU' 'MANU' 'Time (min)' LT_MIN 'Temperature (C)' LY_00;
EVT_10  = EVOL 'ORAN' 'MANU' 'Time (min)' LT_MIN 'Temperature (C)' LY_10;
EVT_20  = EVOL 'JAUN' 'MANU' 'Time (min)' LT_MIN 'Temperature (C)' LY_20;
EVT_30  = EVOL 'ROSE' 'MANU' 'Time (min)' LT_MIN 'Temperature (C)' LY_30;
EVT_40  = EVOL 'VERT' 'MANU' 'Time (min)' LT_MIN 'Temperature (C)' LY_40;
EVT_50  = EVOL 'TURQ' 'MANU' 'Time (min)' LT_MIN 'Temperature (C)' LY_50;
EVT_120 = EVOL 'BLAN' 'MANU' 'Time (min)' LT_MIN 'Temperature (C)' LY_120;

* 4. Draw a complete temperature graph with 50-unit divisions.
*DESS (EVT_00 ET EVT_10 ET EVT_20 ET EVT_30 ET EVT_40 ET EVT_50 ET EVT_120)
     'XBOR' 0. 240. 'XGRA' 10.
     'YBOR' 0. 500. 'YGRA' 25.
     'GRIL' 'POIN' 'GRIS'
     TITRE 'Temperature Evolution at Measurement Points' ;

