              117.0 121.0 124.9 128.9 132.8 136.7 138.8 140.8 142.9 144.9
              146.9 149.0 151.0 153.0 155.1 156.8 157.9 159.0 160.1 161.3
              162.4 163.5 164.6 165.8 166.9 168.0 169.1 170.3 ;

* Tạo các đường EVOL cho Dauti (Sử dụng CÙNG MÀU với các đường kết quả của bạn)
EVE_00 = EVOL 'BLEU' 'MANU' 'Time (min)' L_MIN_EXP 'T_Ex_00' LTE_00 ;
EVE_10 = EVOL 'ORAN' 'MANU' 'Time (min)' L_MIN_EXP 'T_Ex_10' LTE_10 ;
EVE_20 = EVOL 'JAUN' 'MANU' 'Time (min)' L_MIN_EXP 'T_Ex_20' LTE_20 ;
EVE_30 = EVOL 'ROSE' 'MANU' 'Time (min)' L_MIN_EXP 'T_Ex_30' LTE_30 ;
EVE_40 = EVOL 'VERT' 'MANU' 'Time (min)' L_MIN_EXP 'T_Ex_40' LTE_40 ;
EVE_50 = EVOL 'TURQ' 'MANU' 'Time (min)' L_MIN_EXP 'T_Ex_50' LTE_50 ;
EVE_120 = EVOL 'BLAN' 'MANU' 'Time (min)' L_MIN_EXP 'T_Ex_120' LTD_120 ;


*===================================================================*
* 2. THIẾT LẬP BẢNG KIỂU NÉT VẼ (TABLE DE DESSIN)
*===================================================================*
TAB_DESS = TABLE ;

* Nhóm 1: 7 đường nét liền ('LIGN') cho kết quả mô phỏng của bạn
TAB_DESS . 1 = 'LIGN' ; TAB_DESS . 2 = 'LIGN' ; TAB_DESS . 3 = 'LIGN' ;
TAB_DESS . 4 = 'LIGN' ; TAB_DESS . 5 = 'LIGN' ; TAB_DESS . 6 = 'LIGN' ;
TAB_DESS . 7 = 'LIGN' ; 

* Nhóm 2: Thực nghiệm (7 đường nét chấm - TIRC)
TAB_DESS . 8 = 'TIRC' ; TAB_DESS . 9 = 'TIRC' ; TAB_DESS . 10 = 'TIRC' ;
TAB_DESS . 11 = 'TIRC' ; TAB_DESS . 12 = 'TIRC' ; TAB_DESS . 13 = 'TIRC' ;
TAB_DESS . 14 = 'TIRC' ;

*===================================================================*
* 3. HIỂN THỊ ĐỒ THỊ SO SÁNH TRỰC QUAN (DOUBLE-LAYER CALIBRATION MY CODE VS EXPERIMENT)
*===================================================================*
DESS (EVT_00 ET EVT_10 ET EVT_20 ET EVT_30 ET EVT_40 ET EVT_50 ET EVT_120
   ET EVE_00 ET EVE_10 ET EVE_20 ET EVE_30 ET EVE_40 ET EVE_50 ET EVE_120)
     TAB_DESS
     'XBOR' 0. 240. 'XGRA' 10.
     'YBOR' 0. 500. 'YGRA' 25.
     'GRIL' 'POIN' 'GRIS'
     TITRE 'Temperature Calibration: Current Model (Solid) vs Exp (Dotted)' ;


