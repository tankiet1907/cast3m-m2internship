LSW_50_1  = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN (EXTR EV_SW_50 'ORDO')) ;
LSW_120_1 = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN (EXTR EV_SW_120 'ORDO')) ;

* 3. Đóng gói lại thành các EVOL mới với nhãn mác rõ ràng để xuất CSV
EV_EX_SW_00  = EVOL 'BLEU' 'MANU' 'Time(min)' L_MIN_1 'SW_00mm'  LSW_00_1 ;
