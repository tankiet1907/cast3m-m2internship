*===================================================================*
*********** EXPORT HYDRATION DEGREE (0-->1) EVERY 1 MINUTE ***********
*===================================================================*

* 1. Initialize empty data arrays 
LHY_00 = PROG ; 
LHY_10 = PROG ; 
LHY_20 = PROG ; 
LHY_30 = PROG ;
LHY_40 = PROG ; 
LHY_50 = PROG ;
LHY_120 = PROG ;

* 2. Type Casting and Extraction Loops (Optimizing nested code writing)
N_STEP = 0 ;
REPETER BOU_HY (DIME TAB0 . 'HYDRATATION') ;
* Read MCHAML and immediately convert to CHPOINT
   HY_CHPO = CHAN 'CHPO' (TAB0 . 'HYDRATATION' . N_STEP) MODTHC ;

* Extract values ​​and append them directly to the array (without creating intermediate variables)
   LHY_00 = LHY_00 ET (PROG (EXTR HY_CHPO 'SCAL' PO_00)) ;
   LHY_10 = LHY_10 ET (PROG (EXTR HY_CHPO 'SCAL' PO_10)) ;
   LHY_20 = LHY_20 ET (PROG (EXTR HY_CHPO 'SCAL' PO_20)) ;
   LHY_30 = LHY_30 ET (PROG (EXTR HY_CHPO 'SCAL' PO_30)) ;
   LHY_40 = LHY_40 ET (PROG (EXTR HY_CHPO 'SCAL' PO_40)) ;
   LHY_50 = LHY_50 ET (PROG (EXTR HY_CHPO 'SCAL' PO_50)) ;
   LHY_120 = LHY_120 ET (PROG (EXTR HY_CHPO 'SCAL' PO_120)) ;
   N_STEP = N_STEP + 1 ;
FIN BOU_HY ;

* 4. Nội suy dữ liệu về mốc 1 phút bằng IPOL
* Cú pháp: IPOL [Trục X mới] (EVOL 'MANU' [Trục X cũ] [Giá trị Y cũ])
LHY_00_1 = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN 'HYD' LHY_00) ;
LHY_10_1 = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN 'HYD' LHY_10) ;
LHY_20_1 = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN 'HYD' LHY_20) ;
LHY_30_1 = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN 'HYD' LHY_30) ;
LHY_40_1 = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN 'HYD' LHY_40) ;
LHY_50_1 = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN 'HYD' LHY_50) ;
LHY_120_1 = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN 'HYD' LHY_120) ;

* 5. Tạo đối tượng EVOL với trục thời gian mới
EV_HYDR_00 = EVOL 'BLEU' 'MANU' 'Time (min)' L_MIN_1 'Hyd_00mm' LHY_00_1 ;
EV_HYDR_10 = EVOL 'ORAN' 'MANU' 'Time (min)' L_MIN_1 'Hyd_10mm' LHY_10_1 ;
EV_HYDR_20 = EVOL 'JAUN' 'MANU' 'Time (min)' L_MIN_1 'Hyd_20mm' LHY_20_1 ;
EV_HYDR_30 = EVOL 'ROSE' 'MANU' 'Time (min)' L_MIN_1 'Hyd_30mm' LHY_30_1 ;
EV_HYDR_40 = EVOL 'VERT' 'MANU' 'Time (min)' L_MIN_1 'Hyd_40mm' LHY_40_1 ;
EV_HYDR_50 = EVOL 'TURQ' 'MANU' 'Time (min)' L_MIN_1 'Hyd_50mm' LHY_50_1 ;
EV_HYDR_120 = EVOL 'BLAN' 'MANU' 'Time (min)' L_MIN_1 'Hyd_120mm' LHY_120_1 ;

* 4. Combine everything into one data package
EV_EXPORT_HYDR = EV_HYDR_00 ET EV_HYDR_10 ET EV_HYDR_20 ET EV_HYDR_30 ET EV_HYDR_40 ET EV_HYDR_50 ET EV_HYDR_120;
DESS EV_EXPORT_HYDR
     'XBOR' 0. 240. 'XGRA' 10.
     'YBOR' 0. 1. 'YGRA' 0.1
     'GRIL' 'POIN' 'GRIS'
     TITRE 'Hydration degree Evolution at Measurement Points' ;

* 5. Export to CSV file
OPTI 'SORT' 'D:\cast3m-m2internship\02.Simulation\02.Results\HydrationDegree_1min_Intervals.csv' ;
SORT 'EXCE' EV_EXPORT_HYDR ;






