*********** EXPORT SATURATION DEGREE (SW) EVERY 1 MINUTE ***********
*===================================================================

* 2. Khởi tạo các mảng PROG rỗng để lưu lịch sử SW cho từng điểm
LSW_00 = PROG ; 
LSW_10 = PROG ; 
LSW_20 = PROG ; 
LSW_30 = PROG ; 
LSW_40 = PROG ; 
LSW_50 = PROG ; 
LSW_120 = PROG ;

* Lặp qua tất cả các bước thời gian để trích xuất giá trị SW tại các điểm
N1 = 0;
REPETER BOU_EXTR_SW (DIME TAB0 . 'SW') ;
   CH_SWi = TAB0 . 'SW' . N1 ;
   
* Trích xuất giá trị SCAL tại từng điểm (PO_00, PO_10,...) và nối vào PROG
   LSW_00  = LSW_00  ET (PROG (EXTR CH_SWi 'SCAL' PO_00)) ;
   LSW_10  = LSW_10  ET (PROG (EXTR CH_SWi 'SCAL' PO_10)) ;
   LSW_20  = LSW_20  ET (PROG (EXTR CH_SWi 'SCAL' PO_20)) ;
   LSW_30  = LSW_30  ET (PROG (EXTR CH_SWi 'SCAL' PO_30)) ;
   LSW_40  = LSW_40  ET (PROG (EXTR CH_SWi 'SCAL' PO_40)) ;
   LSW_50  = LSW_50  ET (PROG (EXTR CH_SWi 'SCAL' PO_50)) ;
   LSW_120 = LSW_120 ET (PROG (EXTR CH_SWi 'SCAL' PO_120)) ;
   
   N1 = N1 + 1;
FIN BOU_EXTR_SW ;

* 3. Nội suy (IPOL) về mốc thời gian mục tiêu (mỗi 1 phút)
LSW_00_1  = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN LSW_00) ;
LSW_10_1  = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN LSW_10) ;
LSW_20_1  = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN LSW_20) ;
LSW_30_1  = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN LSW_30) ;
LSW_40_1  = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN LSW_40) ;
LSW_50_1  = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN LSW_50) ;
LSW_120_1 = IPOL L_MIN_1 (EVOL 'MANU' LT_MIN LSW_120) ;

* 4. Đóng gói dữ liệu thành các đồ thị (EVOL) với màu sắc khác nhau
EV_EX_SW_00  = EVOL 'BLEU' 'MANU' 'Time(min)' L_MIN_1 'SW_00mm' LSW_00_1 ;
EV_EX_SW_10  = EVOL 'ORAN' 'MANU' 'Time(min)' L_MIN_1 'SW_10mm' LSW_10_1 ;
EV_EX_SW_20  = EVOL 'JAUN' 'MANU' 'Time(min)' L_MIN_1 'SW_20mm' LSW_20_1 ;
EV_EX_SW_30  = EVOL 'ROSE' 'MANU' 'Time(min)' L_MIN_1 'SW_30mm' LSW_30_1 ;
EV_EX_SW_40  = EVOL 'VERT' 'MANU' 'Time(min)' L_MIN_1 'SW_40mm' LSW_40_1 ;
EV_EX_SW_50  = EVOL 'TURQ' 'MANU' 'Time(min)' L_MIN_1 'SW_50mm' LSW_50_1 ;
EV_EX_SW_120 = EVOL 'BLAN' 'MANU' 'Time(min)' L_MIN_1 'SW_120mm' LSW_120_1 ;

* Gom tất cả lại để hiển thị
EV_EXPORT_SW = EV_EX_SW_00 ET EV_EX_SW_10 ET EV_EX_SW_20 ET EV_EX_SW_30 ET EV_EX_SW_40 ET EV_EX_SW_50 ET EV_EX_SW_120 ;

* Vẽ đồ thị kiểm tra
DESS EV_EXPORT_SW 'TITR' 'Evolution of Saturation Degree (SW)' 'LEGE' ;

* 5. Xuất dữ liệu ra file CSV
OPTI 'SORT' 'D:\cast3m-m2internship\02.Simulation\02.Results\Saturation_1min_Intervals.csv' ;
SORT 'EXCE' EV_EXPORT_SW ;


* =========================================================
* 1. TÍNH TOÁN MASS LOSS (%)
* =========================================================
L_TIME_ML   = PROG ;
L_ML_PCT    = PROG ;
MASS_0      = 0.0 ;

* --- ĐỊNH NGHĨA HẰNG SỐ ---
PORO  = 0.1 ; 
RHOW  = 1000.0 ;
W_INF = winf ; 

N1 = 0 ;
REPETER BOU_ML (DIME TAB0 . 'TEMPERATURES') ;
* Trích xuất các trường tại bước N1
    CHTKi = EXCO 'T' TAB0 . 'TEMPERATURES' . N1 ;
    CHPCi = EXCO 'PC' TAB0 . 'TEMPERATURES' . N1 ;
    CHPGi = EXCO 'PG' TAB0 . 'TEMPERATURES' . N1 ;
    HYDRi = CHAN CHPO (TAB0 . 'HYDRATATION' . N1) MODTHC ;

* Tính SW và Mật độ hơi nước RHOGW
    CHPVSATi CHPGWSCi RHOGWi XX YY ZZ = @PVSAT CHPGi CHPCi CHTKi ;
    SWi = @SATURA CHPCi CHTKi HYDRi cha1 chb1 chc1 chgam0 ;

* Tính tổng nước (Lỏng + Hơi + Liên kết) [kg/m3]
    W_LIQ   = SWi * (PORO * RHOW) ;
    CH_SG   = (MANU CHPO MAIL1 1 'SCAL' 1.0) - SWi ;
    W_VAP   = CH_SG * RHOGWi * PORO ;
    W_BOUND = HYDRi * W_INF ;
    W_TOT   = W_LIQ + W_VAP + W_BOUND ;

* Tích phân trên toàn thể tích => Khối lượng [kg]
    CHAM_W = CHAN 'CHAM' W_TOT MODTHC ;
    MASS_I = INTG MODTHC CHAM_W ;

* Lưu khối lượng ban đầu tại t=0
    SI (N1 EGA 0) ;
        MASS_0 = MASS_I ;
    FINSI ;

* Tính Mass Loss theo %
* Kiểm tra MASS_0 để tránh chia cho 0
    SI (MASS_0 NEG 0.0) ;
        M_LOSS_PCT = ((MASS_0 - MASS_I) / MASS_0) * 100.0 ;
    SINON ;
        M_LOSS_PCT = 0.0 ;
    FINSI ;
    
* Đưa vào mảng
    T_I = TAB0 . 'TEMPS' . N1 ;
    L_TIME_ML   = L_TIME_ML ET (PROG (T_I / 60.)) ; 
    L_ML_PCT    = L_ML_PCT ET (PROG M_LOSS_PCT) ;

    N1 = N1 + 1 ;
FIN BOU_ML ;

* Đóng gói đồ thị Full Time
EV_ML_FULL = EVOL 'MANU' 'Time (min)' L_TIME_ML 'Mass Loss (%)' L_ML_PCT ;

* =========================================================
* 2. CẮT VÀ VẼ ĐỒ THỊ TRONG VÙNG 240 PHÚT
* =========================================================
L_MIN_240 = PROG 0. PAS 5. 240. ;
L_ML_240  = IPOL L_MIN_240 EV_ML_FULL ;

* Tạo đối tượng đồ thị cuối cùng
EV_ML_240 = EVOL 'ROUG' 'MANU' 'Time (min)' L_MIN_240 'Mass Loss (%)' L_ML_240 ;

* Vẽ ra màn hình
DESS EV_ML_240 ;

* =========================================================
* 3. XUẤT DỮ LIỆU RA FILE CSV
* =========================================================
OPTI 'SORT' 'D:\cast3m-m2internship\02.Simulation\02.Results\MassLoss_1min_Intervals.csv' ;
SORT 'EXCE' EV_ML_240 ;






















