***********************************************************************
*
* Plaque perforée
* Modelisation mecanique elastique lineaire
* G. Sciumè
*
* Formation Cast3M (I2M - 27/04/2017)
*
***********************************************************************


OPTI ECHO 0;


***********************************************************************
* 1) Choix de la géométrie et du maillage 
***********************************************************************
OPTI 'DIME' 2 'ELEM' 'QUA8' ;

* DEFINITION DES LONGUEURS ET DENSITES DE MAILLES
LONG     = 0.24 ;
HAUT     = 0.10 ;
RAYON    = 0.02 ;

NLONG    = 24 ;
NHAUT    = 4 ;
NBASG    = 10 ;
NBASD    = 10 ;
NQCG     = 8 ;
NQCD     = 8 ;

DGROS    = 0.02;
DFIN     = 0.01;
NELEM1   = 8;
NELEM2   = 16;

* CREATION DES POINTS D'APPUI DU MAILLAGE
PA       = 0. 0. ;
PB       = ((0.5 * LONG) – RAYON) 0. ; 
PC       = (0.5 * LONG) RAYON ;
PD       = ((0.5 * LONG) + RAYON) 0. ;
PE       = LONG 0. ;
PF       = LONG HAUT ; 
PG       = 0. HAUT ;
PCEN     = (0.5 * LONG) 0. ;
TRAC (PA et PB et PC et PD et PE et PF et PG et PCEN);
*
XH = (0.5 * LONG) - (RAYON * (COS 45));
YH =  RAYON * (SIN 45);
XI = (0.5 * LONG) + (RAYON * (COS 45));
YI =  RAYON * (SIN 45);
PH =  XH YH;
PI =  XI YI;
PL =  (0.5 * LONG) HAUT ;
TRAC (PA et PB et PC et PD et PE et PF et PG et PCEN et PH et PI et PL);

LAB   = DROI (-1*NELEM2) PA PB 'DINI' DGROS 'DFIN' DFIN;
LBH   = CERC   NELEM1  PB PCEN PH;
LHG   = DROI (-1*NELEM2) PH PG 'DINI' DFIN 'DFIN' DGROS;
LGA   = DROI NELEM1 PG PA;
*
LHC   = CERC NELEM1 PH PCEN PC;
LCL   = DROI (-1*NELEM2) PC PL 'DINI' DFIN 'DFIN' (0.7 * DGROS);
LLG   = DROI NELEM1 PL PG;
*
LCI   = CERC NELEM1 PC PCEN PI;
LIF   = DROI (-1*NELEM2) PI PF 'DINI' DFIN 'DFIN' DGROS;
LFL   = DROI NELEM1 PF PL;
*
LID   = CERC NELEM1 PI PCEN PD;
LDE   = DROI (-1*NELEM2) PD PE 'DINI' DFIN 'DFIN' DGROS;
LEF   = DROI NELEM1 PE PF;

* CREATION DES SURFACES
SURF1 = DALL LAB LBH LHG LGA 'PLAN';
SURF2 = DALL LHC LCL LLG LHG 'PLAN';
SURF3 = DALL LCI LIF LFL LCL 'PLAN';
SURF4 = DALL LID LDE LEF LIF 'PLAN';
MAIL1 = SURF1 et SURF2 et SURF3 et SURF4;
TRAC MAIL1 ;
***********************************************************************


***********************************************************************
* 2) Définition du modèle mathématique 
***********************************************************************
MOD1 = MODE MAIL1 MECANIQUE ELASTIQUE ISOTROPE;
MAT1 = MATE MOD1 'YOUN' 210.E9 'NU' 0.25 'RHO' 7800. 'ALPH' 1.E-5;
***********************************************************************


***********************************************************************
* 3) Résolution du problème discrétisé
***********************************************************************

* DEFINIZIONE CONDIZIONI AL CONTORNO
CL1 = BLOQ 'UY' (LAB et LDE);
CL2 = BLOQ 'UX' LGA;
CL_TOT = CL1 et CL2;

* CALCOLO DELLA MATRICE DI RIGIDEZZA
RIG0 = RIGI MOD1 MAT1;
RIG1 = RIG0 et CL_TOT;

* DEFINIZIONE CARICO SU L14
CHA1 = PRES 'MASS' MOD1 -200.E6 LEF;

* RISOLUZIONE 
DEP1 = RESO RIG1 CHA1;

***********************************************************************




***********************************************************************
* 4) Analyse et post-traitement des résultats
***********************************************************************
cont_tot = CONT MAIL1;
DEFO0 =  'DEFO' cont_tot DEP1 0.;
DEFO1 =  'DEFO' cont_tot DEP1 50. 'ROUG';
'TRAC' (DEFO0 'ET' DEFO1) ;

* Contraintes
SIG1 = SIGMA MOD1 MAT1 DEP1 ;
*
SIG_MAX = MAXI ('EXCO' 'SMXX' SIG1);
SIG_MIN = MINI ('EXCO' 'SMXX' SIG1);
SCALA_S = PROG SIG_MIN PAS (SIG_MAX - SIG_MIN / 16) SIG_MAX;
TRAC SIG1 MOD1 (CONT MAIL1) SCALA_S;

* Evolution containte sur la ligne CL
SIG1P = CHAN CHPO SIG1 MOD1;
EVOL1 = EVOL 'ROUG' 'CHPO'  SIG1P  'SMXX'  LCL;
DESS EVOL1;
***********************************************************************





























