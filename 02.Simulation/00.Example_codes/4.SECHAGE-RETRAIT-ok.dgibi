*---------------------------------------------------------------------*
* Cas-test de sechage et retrait
* G. Sciumè (24-04-2017)
*---------------------------------------------------------------------*
*
OPTI ECHO 0;
OPTI DIME 3 MODE TRID ELEM CUB8;
*
*---------------------------------------------------------------------*
* PROCEDURES PERSONNELLES
*---------------------------------------------------------------------*
DEBP sldegre pcap*'FLOTTANT';
   temp1 = b1/(b1-1.);
   temp2 = pcap/a1;
   temp3 = 1. + (temp2**temp1);
   temp4 = -1./b1;
   sldegre = temp3**temp4;
FINP sldegre;
*
DEBP sldepc pcap*'FLOTTANT';
   temp1 = b1/(b1-1.);
   temp2 = pcap/a1;
   temp3 = 1. + (temp2**temp1);
   temp4 = -1.*((b1 + 1.)/b1);
   temp5 = temp3**temp4;
   temp6 = pcap**(1./(b1 - 1.));
   temp7 = a1**(b1/(b1 - 1.));
   temp8 = temp6/temp7;
   temp9 = (-1./(b1 - 1.))*temp8;
   sldepc =  temp5 * temp9;
FINP sldepc;
*
DEBP krl pcap*'FLOTTANT';
   temp1 = b1/(b1-1.);
   temp2 = pcap/a1;
   temp3 = 1. + (temp2**temp1);
   temp4 = -1./b1;
   temp5 = temp3**temp4;
   temp6 = 1. - (temp5**b1);
   temp7 = temp6**(1./b1);
   temp8 = (1. - temp7)**2.;
   temp9 = temp5**0.5;
   krl = temp8 * temp9;
FINP krl;
*
DEBP hr_chpo pcap*'CHPOINT' mail1*'MAILLAGE';
   temp0 = (EXCO pcap  'T') 'NOMC' 'SCAL';
   temp1 = 18.e-3 / (8.314 * 1000. * 293.15);
   temp2 = temp0 * temp1 * -1.;
   chhpc = EXP(temp2);
FINP chhpc;
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* PARAMETRES MATERIAU
*---------------------------------------------------------------------*
RHO  = 1000.;
EPS  = 0.2;
A1   = 20.E6;
B1   = 2.;
KINT = 1.E-20;
VISC = 1.E-3 ;
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* CONDITIONS INITIALES ET EXTERNES
*---------------------------------------------------------------------*
TEMPE1 = 20.0;
HR_EXT = 0.50;
HR_INI = 0.90;
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* CONSTRUCTION DU MAILLAGE: 1/8 de d'un' EPROUVETTE CUBIQUE 
*---------------------------------------------------------------------*
LATO1    = 0.10;
DENS_GRO = 0.01;
DENS_FIN = 0.002;
*
p1    =  0.        0.  0.;
p2    = (LATO1/2.) 0.  0.;
l12   =  DROI p1 p2 'DINI' DENS_GRO 'DFIN' DENS_FIN;
SURF1 = l12 TRANS (0. (LATO1/2.) 0.) 'DINI' DENS_GRO 'DFIN' DENS_FIN;
trac SURF1;
*
VEC1  = 0. 0. (LATO1/2.);
MAIL1 = SURF1 VOLU TRAN VEC1 'DINI' DENS_GRO 'DFIN' DENS_FIN;
TRAC CACH MAIL1;
*
* EXTRACTION DES SURFACES
p3 = (LATO1/2.) (LATO1/2.)  0. ;
p4 =  0.   (LATO1/2.)  0.;
p5 = (LATO1/2.) (LATO1/2.)  0.01;
p6 = 0.000 (LATO1/2.)  0.01;
P_CONT1 = 'POIN' MAIL1 'PLAN' p2 p3 p5 0.0005;
P_CONT2 = 'POIN' MAIL1 'PLAN' p3 p4 p6 0.0005;
P_CONT = P_CONT1 et P_CONT2;
trac P_CONT;
*
CONTH = (face 3 mail1) 'ELEM' 'APPUYE' 'STRICTEMENT' P_CONT;
trac conth;
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* DISCRETIZATION TEMPORELLE 
*---------------------------------------------------------------------*
heure1  = 3600.;
jour1   = 24  * heure1;
TFIN    = 120 * jour1;
LTEMPS1 = PROG 0. PAS (24 * heure1) TFIN;
*---------------------------------------------------------------------*                                                

*---------------------------------------------------------------------*
* DEFINITION DU MODELE ET DU MATERIAU 
*---------------------------------------------------------------------*
MO_HYGR = MODE MAIL1 THERMIQUE;
MO_CONV = MODE CONTH THERMIQUE CONVECTION;
MO_TOT  = MO_HYGR et MO_CONV;

* CAPACITY COEFFICIENT 
tXPC  = 0.;
tYDSW = 0.;
XPC  = PROG tXPC;
YDSW = PROG tYDSW;
REPETER BOUCLE (150);
  tXPC = tXPC + 1.E6;
  tYDSW = sldepc tXPC;
  XPC  = XPC  et (PROG tXPC);
  YDSW = YDSW et (PROG tYDSW);
FIN BOUCLE;
DSWPC = EVOL MANU 'T' XPC 'T' YDSW;
YCP   = -1. * YDSW * EPS * RHO;
CP    =  EVOL MANU 'T' XPC 'C' YCP;
DESS CP;

* CONDUCTIVITY COEFFCIENT
tXPC  = 0.;
tYKRL = 1.;
XPC  = PROG tXPC;
YKRL = PROG tYKRL;
REPETER BOUCLE (150);
  tXPC = tXPC + 1.E6;
  tYKRL = krl tXPC;
  XPC  = XPC et (PROG tXPC);
  YKRL = YKRL et (PROG tYKRL);
FIN BOUCLE;
YK    = YKRL * ((RHO * KINT)/VISC);
K_EFF = EVOL MANU 'T' XPC 'K' YK;
DESS K_EFF;

MA_HYGR = MATE MO_HYGR 'RHO' 1. 'C' CP 'K' K_EFF;



MA_CONV = MATE MO_CONV 'H' 1.E-13;
MA_TOT  = MA_HYGR et MA_CONV;
*---------------------------------------------------------------------*



*_______Application condition initiales_________________
PC_INI = -8.314*293.15*1000*(LOG(HR_INI))/18.e-3;
PC0    = MANU 'CHPO' MAIL1 'T'  PC_INI;

*_______Application condition limites____________________
PC_EXT  = -8.314 * 293.15 * 1000. * (LOG(HR_EXT)) / 18.e-3;
CONV1   = MANU 'CHPO' CONTH 1 'T' PC_EXT 'NATURE' 'DISCRETE';
EV_CHAR = EVOL MANU 'TEMPS' (PROG 0. TFIN) 'T' (PROG 1. 1.);
CHAR1   = CHAR 'TECO' CONV1 EV_CHAR;




*---------------------------------------------------------------------*
* RESOLUTION PASAPAS 
*---------------------------------------------------------------------*
tab1= table;
tab1.TEMPERATURES= table;
tab1.TEMPERATURES.0= pc0;
tab1.MODELE= mo_tot;
tab1.CARACTERISTIQUES= ma_tot;
tab1.CHARGEMENT= CHAR1;
tab1.PROCEDURE_THERMIQUE= NONLINEAIRE;
tab1.RELAXATION_THETA= 0.51;
tab1.TEMPS_CALCULES= ltemps1;
PASAPAS tab1;
*---------------------------------------------------------------------*



*********** Visualizzazione dei risultati
tab_hr  = TABLE;
nbt2    = DIME tab1.TEMPERATURES;
list nbt2;


n10 = 0;
REPETER BOUCLE (nbt2);
  tab_hr.n10 = hr_chpo  tab1.TEMPERATURES.n10  mail1;
  n10 = n10 + 1;
FIN BOUCLE;

SCALA_HR = PROG 0.5 PAS ((0.9-0.5)/16) 0.9;
trac tab_hr.0   mail1 SCALA_HR;
trac tab_hr.30  mail1 SCALA_HR;
trac tab_hr.60  mail1 SCALA_HR;
trac tab_hr.90  mail1 SCALA_HR;
trac tab_hr.120 mail1 SCALA_HR;


*l_tot = l12 et l23 et l34;
*
***Umidità relativa sull'asse
*evhr_1 = evol ROUG CHPO tabrh.20  l_tot;
*evhr_2 = evol VERT CHPO tabrh.40 l_tot;
*evhr_3 = evol BLEU CHPO tabrh.130 l_tot;
*dess (evhr_1 et evhr_2 et evhr_3);



*************************************************************************
opti sauv 'FORMAT' 'C:\Users\gsciume\castem\SECHAGE';
sauv 'FORMAT';
*************************************************************************














*************************************************************************
opti rest 'FORMAT' 'C:\Users\gsciume\castem\SECHAGE';
rest 'FORMAT';
*************************************************************************


OPTI ECHO 0;


*************************************************************************
DEBP sl_chpo pcap*'CHPOINT' mail1*'MAILLAGE';
   pcap0 = pcap 'NOMC' 'SCAL'; 
   temp1 = b1/(b1-1.);
   temp2 = pcap0 * (1/a1);
   temp3 = 1. + (temp2 ** temp1);
   temp4 = -1./b1;
   chsl = temp3**temp4;
FINP chsl;
*************************************************************************



************************************************************************
* PARAMETRES MECANIQUES
************************************************************************
eyou1  =  30.e9;
nu1    =  0.2;
BIOT1  =  0.60;
*
BULK1    = eyou1 / (3 * (1 - (2. * nu1)));
ALPHA_EQ = BIOT1 / (3. * BULK1);
************************************************************************


************************************************************************
* Definition du modele et du materiau
************************************************************************
MODM = MODE MAIL1 MECANIQUE ELASTIQUE;
MATM = MATE MODM 'YOUN' eyou1 'NU ' nu1 'ALPHA' ALPHA_EQ;
************************************************************************




************************************************************************
* Definition des conditions aux limites
*   - Blocages mecaniques
************************************************************************
 
BASE1 = surf1;
*
p7 = p2 'PLUS' (0.0  0.0 0.1);
p8 = p4 'PLUS' (0.0  0.0 0.1);
*
P_CO12 = 'POIN' MAIL1 'PLAN' p1 p2 p7 0.0005;
P_CO14 = 'POIN' MAIL1 'PLAN' p1 p4 p8 0.0005;
*
LATO12 = (face 3 mail1) 'ELEM' 'APPUYE' 'STRICTEMENT' P_CO12;
LATO14 = (face 3 mail1) 'ELEM' 'APPUYE' 'STRICTEMENT' P_CO14;
trac (BASE1 et LATO12 et LATO14);
*
CONTM1 =  BASE1;
CONTM2 =  LATO12;
CONTM3 =  LATO14;
rig1   = BLOQ 'UZ' CONTM1;
rig2   = BLOQ 'UY' CONTM2;
rig3   = BLOQ 'UX' CONTM3;
RIGTOT = rig1 et rig2 et rig3;


************************************************************************
* APPLICATION CHARGEMENTS
*   - Thermique et mecanique
************************************************************************
* Calcul de la pression sur le skeletre solide
TAB1.PS = 'TABLE';
NTAB1 = DIME TAB1.TEMPERATURES;
LIST NTAB1;
*
N0 = 0;
REPETER BOU_PS NTAB1;
   satu = sl_chpo  TAB1 . 'TEMPERATURES' . N0 MAIL1;
   pc   = ('EXCO' 'T' TAB1 . 'TEMPERATURES' . N0) 'NOMC' 'SCAL';
   ps   = (-1. * satu * pc) 'NOMC' 'T';
   TAB1 . 'PS' . N0 = ps;
   N0 = N0 + 1;
FIN BOU_PS;
*
*LIST TAB1 . 'PS';

CHAM_TH = CHAR 'T'  (TAB1 . 'TEMPS')  (TAB1 . 'PS') ;
***********************************************************************



*---------------------------------------------------------------------*
* Resolution PASAPAS2
*---------------------------------------------------------------------*
TAB1M                         = 'TABL' ;
TAB1M . 'MODELE'              = MODM;
TAB1M . 'CARACTERISTIQUES'    = MATM;
TAB1M . 'BLOCAGES_MECANIQUES' = RIGTOT ;
TAB1M . 'CHARGEMENT'          = CHAM_TH;
TAB1M . 'TEMPS_CALCULES'      = ltemps1;
*---------------------------------------------------------------------*
PASAPAS TAB1M ;


*************************************************************************
opti sauv 'FORMAT' 'C:\Users\gsciume\castem\RETRAIT';
sauv 'FORMAT';
*************************************************************************







*************************************************************************
opti rest 'FORMAT' 'C:\Users\gsciume\castem\RETRAIT';
rest 'FORMAT';
*************************************************************************


OPTI ECHO 0;





***** Deformazione longitudinale media ******************************
***** A PARTIRE DA UN GIORNO (COME FATTO PER LA MISURA)
dimet = DIME TAB1M . 'DEPLACEMENTS' ;
list dimet;
*
p3 = MAIL1 POIN PROC (0.  0. (LATO1/2));
L0 = LATO1/2;
trac CACH (MAIL1 et P3);


temps    = PROG;
ret      = PROG;
*
n6 = 0;
REPETER BOUCLE dimet;
  temps1 = TAB1 . 'TEMPS' . n6;
  temps1 = temps1 / 86400. ;
  temps  = temps ET (PROG temps1);
  retrait1 =  EXTR TAB1M.DEPLACEMENTS.n6 'UZ' p3;
  deltaA   = (retrait1 / L0 )*1000000.;
  ret      = ret ET (PROG deltaA);
  n6 = n6 + 1;
FIN BOUCLE;
*
evret = EVOL 'BLAN' 'MANU' 'JOURS' temps 'MICRON/METER' ret;
DESS evret;
***


def_T0 = DEFO mail1  tab1m.deplacements.0 1000;
def_T =  DEFO mail1  tab1m.deplacements.(dimet - 1) 1000 ROUG;
trac cach (def_T0 et def_T);








**** PROCEDURA PARAVIEW *************************
ntT = dime TAB1M.DEPLACEMENTS;
list ntt;
a = 0;
*
REPETER BOUCLE (ntT);
*
uXX    = (EXCO 'UX' TAB1M.DEPLACEMENTS.a) 'NOMC' 'SCAL';
uYY    = (EXCO 'UY' TAB1M.DEPLACEMENTS.a) 'NOMC' 'SCAL';
uZZ    = (EXCO 'UZ' TAB1M.DEPLACEMENTS.a) 'NOMC' 'SCAL';
HR     = (EXCO 'SCAL' tab_hr.a)           'NOMC' 'SCAL';
*
C_HR  = MANU 'CHPO' MAIL1 4 'HR' 1 'UX' 0 'UY' 0 'UZ'  0;                              
C_UX  = MANU 'CHPO' MAIL1 4 'HR' 0 'UX' 1 'UY' 0 'UZ'  0;  
C_UY  = MANU 'CHPO' MAIL1 4 'HR' 0 'UX' 0 'UY' 1 'UZ'  0;   
C_UZ  = MANU 'CHPO' MAIL1 4 'HR' 0 'UX' 0 'UY' 0 'UZ'  1;  
*
lmot1 = 'MOTS' 'HR'   'UX'   'UY'   'UZ'  ; 
lmot2 = 'MOTS' 'SCAL' 'SCAL' 'SCAL' 'SCAL';
ciao1 =  C_HR  '*'  HR   lmot1 lmot2 lmot1 ;
ciao2 =  C_UX  '*'  UXX  lmot1 lmot2 lmot1 ;
ciao3 =  C_UY  '*'  UYY  lmot1 lmot2 lmot1 ;
ciao4 =  C_UZ  '*'  UZZ  lmot1 lmot2 lmot1 ;
ciaook =  ciao1 + ciao2 + ciao3 + ciao4;
*
DD = ciaook;
*
OPTI SORT 
(chain 'C:\Users\gsciume\castem\PARACAST\SECHAGE'a'.inp');
SORT AVS DD MAIL1;
*
a = a + 1;
fin boucle;
