*---------------------------------------------------------------------*
* TEST 0 : ADIABATIC HYDRATION / AGING / ACCIDENT
* G.Sciumè (31 - 10 - 2024)
*
* Reference
* "CONCRETE CASTING AND LIFETIME CONDITIONS IMPACT ON HIGH 
* TEMPERATURE RESISTANCE"  
*
* G. Sciumè (1), S. Dal Pont (2), D. Dauti (2)
*
* (1) I2M, Université de Bordeaux, Bordeaux, France
* (2) 3SR, Université Grenoble Alpes, Grenoble, France

* Modified by: Tan Kiet Hong (17 - 04 - 2026)                                         
*   - Small optimizations of the code structure (such as variable names)
*   - Reduced time step for the aging phase (from 3 days to 1 day) to better converge the model.                
*   - Update vapor and hydral convection coefficient values and boundary condition for both faces.
*   - Update gas pressure boundary condition for both faces. 
*   - Update convection coefficient for thermal convection and emissivity for radiation for accident phase.
*   - Mesh adapted to Kalifa (2000) experiment (120mm of thickness) 
*   - Add 7 new points of measurement (0, 10, 20, 30, 40, 50, 120 mm from hot face)
*   - Exportation of temperature and gas pressure for the model (gradient model view) 
*   - Exportation of temperature and gas pressure for the points of measurement (time evolution)

* Modified by: Tan Kiet Hong (20 - 04 - 2026)                                         
*   - Update material parameters input.
*   - Update thermal convection for both faces.
*   - Update initial room temperature.
*   - Update relaxation theta and reduce tolerance for better convergence of the model.

* Modified by: Tan Kiet Hong (21 - 04 - 2026)
*   - Correcting some material parameters input.
*   - Update time steps for the accident phase: smaller time steps during the ramp and linear phases, larger time steps during the plateau phase.
*   - Update thermal convection (heat radiator) based on the experimental temperature of front face (400oC at 10 min is gradient so didn't work)
*   - Change accident time from 3hrs to 4hrs (max values before getting error)
*   - Refinement of the mesh: smaller elements near the hot face and larger elements near the cold face. Convert to a 1D mesh to reduce the computational cost.
*   - Debugged the visualization of the results: final time steps of accident phase was overwritten by the last time step of the aging phase, now fixed.

* Modified by: Tan Kiet Hong (22 - 04 - 2026)
*   - Revert to the original time steps for the accident phase
OPTI ECHO 0;


*---------------------------------------------------------------------*
* CONSTANT PHYSICAL PARAMEMTERS
*---------------------------------------------------------------------*
RGP1     = 8.3145 ;                                                   
MMGA1    = 28.9645E-3 ;                                               
MMGW1    = 18.0153E-3 ;
RHOS1    = 2625.8 ;
RHOW0    = 1000. ;
CPW1     = 4181.0 ;
CPGW1    = 1805.0 ;
CPGA1    = 1005.7 ;
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* TEST DESCRIPTION AND TEMPORAL DISCRETIZATION
*---------------------------------------------------------------------*
* 
* Modeled phases
* I)   Early age :        0 ---> 3 days        /  adiabatic conditions 
* II)  Aging     :        3 ---> age time      /  H & T convection
* III) Accident  : age time ---> age time + 6h /  H & T convection
*
*---------------------------------------------------------------------*
hours1   = 3600.       ;
day1     = 86400.      ;
year1    = 360 * day1  ;
*
age_time =   1 * year1 ;
acc_time =   4 * hours1;
*
temps1   =  3 * day1   ;
temps2   =  6 * day1   ;
temps3   =  age_time   ;
temps4   =  temps3 +  acc_time;

DT01     =  600.;
DT12     =  600.;
DT23     =    1 * day1;
DT34     =   60.;

* Calculation of the time steps for the different phases
LTP_HYDR = PROG  0.             PAS DT01 temps1        ;  
LTP_AGIN = PROG (temps1 + DT12) PAS DT12 temps2 PAS DT23 temps3 ;
LTP_ACCI = PROG (temps3 + DT34) PAS  DT34  temps4               ;
LTP_TOT  = LTP_HYDR ET LTP_AGIN ET LTP_ACCI                     ;   

* Saved times
LSA_HYDR = PROG  0.             PAS hours1 temps1; 
LSA_AGIN = PROG (temps1 + DT23) PAS DT23   temps3;                    
LSA_ACCI = PROG (temps3 + DT34 ) PAS DT34  temps4; 
LSA_TOT  = LSA_HYDR ET LSA_AGIN ET LSA_ACCI                     ;  
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* DATI MATERIALE (PARTE THC)
*---------------------------------------------------------------------*

* MIX DATA
cem  = 350.   ;
aggr = 1920.  ;
wc   = 0.32 ;
sc   = 0.108   ;

* HYDRATION PROCESS DATA (affinity. activation energy. hydration heat)
AI   = 6    ;
AP   = 1250.  ;
GAMP = 0.24   ;
ALFA = 48.    ;
EAR1 = 5369.  ;
lat1 = 114.3e6 ;

* INTRINSIC PERMEABILITY
KINT = 7.5E-20 ;

* DESORPTION ISOTHERME MODEL PARAMETERS
a1   =  46.9364E6 ;
b1   =  2.0601   ;
c1   =  1.5     ;

* THERMAL PARAMETERS
CS   = 948.   ;
KS   = 1.67   ;
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* COSTRUZIONE MESH - KALIFA 120x120mm
*---------------------------------------------------------------------*
'OPTI' 'DIME' 2 'MODE' PLAN CONT 'ELEM' QUA4;
* 120mm width (x)
L1       = 0.12 ;
* 120mm height (y)       
H1       = 0.12 ;       
DY_COLD  = 0.001;       
DY_HOT   = 0.005;       
*
P1  = 0.   0.;         
P2  = 0.   H1;         
L12 = DROI P1 P2 'DINI' DY_COLD 'DFIN' DY_HOT;
MAIL1 = (TRAN 1 L12 (L1 0.)) 'COUL' 'VERT';
*
DCD1 = COTE 2 MAIL1;
DAB1 = COTE 4 MAIL1; 

* Alias cho boundary conditions
* DCD1 = hot face (top, y=0.12)
* DAB1 = cold face (bottom, y=0)
*Vapor convection
CONTH = DCD1;
CONTA = DAB1;
CONTH_V= CONTH ET CONTA;

*Thermal convection and radiation
CONTT = DCD1;
CONTC = DAB1;
*
* --- Points of measurement (Kalifa 2000) ---
* x = 0.06 (mid sample), y = 0.120 - distance from hot face
PO_00  = MAIL1 POIN 'PROC' (0.06 0.120);
PO_10  = MAIL1 POIN 'PROC' (0.06 0.110);
PO_20  = MAIL1 POIN 'PROC' (0.06 0.100);
PO_30  = MAIL1 POIN 'PROC' (0.06 0.090);
PO_40  = MAIL1 POIN 'PROC' (0.06 0.080);
PO_50  = MAIL1 POIN 'PROC' (0.06 0.070);
PO_120 = MAIL1 POIN 'PROC' (0.06 0.000);
*
*TRAC MAIL1;
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* DEFINIZIONE DEL MODELLO
*---------------------------------------------------------------------*
MODTHC  = 'MODE' MAIL1 'THERMOHYDRIQUE' 'BETON_THM' 'CONS' 'BO';
MODCOT1 = 'MODE' CONTT 'THERMIQUE' 'CONVECTION';
MODCOT2 = 'MODE' CONTC 'THERMIQUE' 'CONVECTION';
MODRAY  = 'MODE' CONTT 'THERMIQUE' 'RAYONNEMENT' 'INFINI';
MOD_TOT =  MODCOT1 et MODCOT2 et MODTHC et MODRAY ;
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* DEFINIZIONE DEL MATERIALE
*---------------------------------------------------------------------*
WINF GAM0 POR1 APOR = @POWERS cem aggr wc sc;
MATTHC = 'MATE' MODTHC 'CS'  CS    'KS'   KS   'GAM0' GAM0 'WINF' WINF
'VGA' a1   'VGB'  b1   'VGC' c1    'K1' KINT  'AK'   7.  'BK'   1. 
'KLI1' 20000.  'AKLI'   1.  'BKLI' 1. 'POR1' POR1 'APOR' APOR 
'AFF1' Ai  'AFF2' Ap   'AFF3' GAMP 'AFF4' ALFA 'EAR'  EAR1 'QLAT' lat1;
MATCOT1  = 'MATE'  MODCOT1   'H'     10.;
MATCOT2  = 'MATE'  MODCOT2   'H'     10.;
MATRAY  = 'MATE'  MODRAY   'EMIS'   0.;
MAT_TOT = MATCOT1 et MATTHC et MATRAY et MATCOT2;
*---------------------------------------------------------------------


*---------------------------------------------------------------------*
* Convection vapeur (traitée par charther)
* et donc à ne pas ajouter dansle modele total
*---------------------------------------------------------------------*
MODCOH  = 'MODE' CONTH_V 'THERMIQUE' 'CONVECTION' ;
MATCOH  = 'MATE' MODCOH   'H'                0. ;
*---------------------------------------------------------------------*


*---------------------------------------------------------------------*
* CONDIZIONE INIZIALE (COST adibatic calorimetry test) 
* - grado di idratazione iniziale HY_0 = 0
* - temperatura iniziale          TC_0 = 22° 
* - pressione del gas iniziale    PG_0 = p_atm
* - umidità relativa iniziale     HR_0 = 0.999
HY_0   = 0.         ;
TC_0   = 20.           ;
TK_0   = 273.15 + TC_0 ;
PG_0   = 101325.       ;
HR_0   = 0.99995       ;

ZERO1  = MANU 'CHPO' MAIL1 'SCAL' 0.       ;
CHTK_0 = MANU 'CHPO' MAIL1 'T' TK_0        ;
PVS_0 XX YY ZZ KK JJ= @PVSAT ZERO1 ZERO1 CHTK_0    ;

* Clapeyron
PC_0   = PG_0 - PVS_0 + ((-1.)*(RGP1*TK_0*RHOW0*(LOG(HR_0))/MMGW1));
PC_0   = PC_0 'NOMC' 'PC';

* Calcul degre de saturation correspondant
CHPC_0 = MANU CHPO MAIL1 1 'SCAL' (MAXI PC_0);
CHTK_0 = MANU CHPO MAIL1 1 'SCAL' TK_0;
HYDR   = MANU CHPO MAIL1 1 'SCAL' HY_0;
cha1   = MANU CHPO MAIL1 1 'SCAL' a1;
chb1   = MANU CHPO MAIL1 1 'SCAL' b1;
chc1   = MANU CHPO MAIL1 1 'SCAL' c1;
chgam0 = MANU CHPO MAIL1 1 'SCAL' gam0;

SW0    = @SATURA CHPC_0 CHTK_0 HYDR cha1 chb1 chc1 chgam0;

CI_TH  = ('MANU' 'CHPO' MAIL1 2 'PG' PG_0 'T' TK_0)  +  PC_0;
*TRAC CI_TH MAIL1;
*---------------------------------------------------------------------*



*---------------------------------------------------------------------*
* CONDIZIONI AL CONTORNO
* - PC_ext = p_atm  
*
* - TC_ext = 22°C until "age time" then accident ramp (2K/min)
*
*             / 0.95            0      < time < 3 days
* - HR_ext = {  0.95 --> 0.50   3 days < time < 6 days
*             \ 0.50            6 days < time < age time
* - Accident:  PGWe_i  = 1300.;
*---------------------------------------------------------------------*
TK_E  = TK_0;
PG_E  = PG_0;
HR_E1 = 0.95;
HR_E2 = 0.50;

* PG: imposed gas pressure
EV_PG = 'EVOL' 'MANU' 'TEMPS'  ('PROG' 0.  temps4) ('PROG' 1. 1.);
CLPG1 = 'BLOQ' 'PG'         CONTT;
CLPG2 = 'BLOQ' 'PG'         CONTC;
CLPGT = CLPG1 ET CLPG2;   
CHPG1 = 'DEPI'  CLPG1        PG_E;
CHPG2 = 'DEPI'  CLPG2        PG_E;     
CGPG1 = 'CHAR' 'TIMP' CHPG1 EV_PG;
CGPG2 = 'CHAR' 'TIMP' CHPG2 EV_PG;

* T: Thermal convection
* === EXPERIMENTAL T AT FRONT FACE (0mm) ===
* Source: Kalifa 2000, M100 at 600oC
* Digitized Tfront [C] every 5 min, converted to K

* --- 1. Danh sach thoi gian (Tu dong sinh tu 300s den 36000s) ---
* Buoc nhay 300s se tao ra dung 120 gia tri
PRO_TIME_EXP = PROG 0. PAS 300. 36000. ;

* --- 2. Danh sach nhiet do (Do C) duoc trich xuat chinh xac tu anh ---
* Block 1 (Tu 5 den 100 phut)
PRO_TC_EXP = PROG 85.51185 132.7843 164.0376 186.2821 205.7704
    222.2542 236.4517 249.9888 261.5317 273.0746 283.6457 291.4527
    299.2597 307.0667 314.8736 321.2718 326.9023 332.5329 338.1635 343.794 ;

* Block 2 (Tu 105 den 200 phut)
PRO_TC_EXP = PRO_TC_EXP ET (PROG 349.4246 354.1489 357.5811 361.0132
    364.4454 367.8776 371.3098 374.7419 378.1741 380.8691 382.9878
    385.1066 387.2253 389.344 391.4627 393.5815 395.7002 397.7859
    399.2378 400.6896) ;

* Block 3 (Tu 205 den 300 phut)
PRO_TC_EXP = PRO_TC_EXP ET (PROG 402.1415 403.5934 405.0453 406.4972
    407.949 409.4009 410.8528 412.3047 413.3293 414.3157 415.3022
    416.2886 417.275 418.2614 419.2478 420.2342 421.2207 422.2071
    423.1935 424.1799) ;

* Block 4 (Tu 305 den 400 phut)
PRO_TC_EXP = PRO_TC_EXP ET (PROG 425.0341 425.7972 426.5604 427.3236
    428.0867 428.8499 429.613 430.3762 431.1394 431.9025 432.6657
    433.4288 413.7946 389.0105 364.1484 346.5834 329.0184 316.1243
    303.9075 291.6907) ;

* Block 5 (Tu 405 den 500 phut)
PRO_TC_EXP = PRO_TC_EXP ET (PROG 281.657 272.3306 263.0042 255.6833
    250.1058 244.5283 238.9508 233.3733 227.7959 223.1796 218.7546
    214.3297 209.9047 205.4797 201.0548 196.9569 193.424 189.8912
    186.3583 182.8255) ;

* Block 6 (Tu 505 den 600 phut)
PRO_TC_EXP = PRO_TC_EXP ET (PROG 179.2926 176.1238 173.2403 170.3568
    167.4734 164.5899 161.6985 158.7551 155.8117 152.8683 149.9249
    147.4087 145.116 142.8233 140.5306 138.2379 135.9451 133.6524
    131.3597 129.067) ;

* --- 3. Chuyen doi sang Kelvin va them diem t=0 ---
* Cong truc tiep 273.15 vao toan bo 120 gia tri
PRO_TK_EXP = PRO_TC_EXP + 273.15 ;
PRO_TK_EXP = (PROG TK_0) ET PRO_TK_EXP ;

LIST (DIME PRO_TIME_EXP);
LIST (DIME PRO_TK_EXP);

* --- Build T loading curve using IPOL ---
N1 = 1;
PRO_TK = PROG;
REPETER BOU_TE (DIME LTP_TOT);
    TIMEi = EXTR N1 LTP_TOT;
    SI (TIMEi '<EG' temps3);
        TKi = TK_0;
    SINON;
        t_rel = TIMEi - temps3;
        TKi = IPOL t_rel PRO_TIME_EXP PRO_TK_EXP;
    FINS;
    PRO_TK = PRO_TK ET (PROG TKi);
    N1 = N1 + 1;
FIN BOU_TE;
EVTK1 = 'EVOL' 'MANU' LTP_TOT PRO_TK;

* --- Hot face: convection + radiation (T_inf = T_rad) ---
*DESS EVTK1;
*DESS EVTK1 'XBOR' temps3 temps4;
CHTK1 = 'MANU' 'CHPO'  CONTT 1 'T'  1. 'NATURE' 'DISCRETE';
CGTK1 = ('CHAR' 'TECO'  CHTK1    EVTK1) ET
        ('CHAR' 'TERA'  CHTK1    EVTK1);

* --- Cold face: convection only (T_inf = T_room = const) ---
EVTC1 = 'EVOL' 'MANU' ('PROG' 0. temps4) ('PROG' TK_0 TK_0);
CHTK2 = 'MANU' 'CHPO' CONTC 1 'T' 1. 'NATURE' 'DISCRETE';
CGTK2 = 'CHAR' 'TECO' CHTK2 EVTC1;

* PC: hygral convection ( qw = hcv * (RGW_s - RGW_ext)n )
N1      = 1   ;
PRO_RGW = PROG;
REPETER BOU_RGW (DIME LTP_TOT);
    EXTR N1 LTP_TOT;
    TIMEi        = EXTR N1 LTP_TOT;
    TKi          = EXTR N1 PRO_TK ;
    PVSe_i XX YY ZZ KK JJ 
           = @PVSAT ZERO1 ZERO1 (MANU 'CHPO' MAIL1 'T' TKi);
    PVSe_i       = MAXI PVSe_i;
    FGPGW0 = (MMGW1 / RGP1 )* (1./TKi) ;
       SI (TIMEi '<' temps1);
       PGWe_i  = HR_E1 * PVSe_i;
       FINS;
       SI (TIMEi '>EG' temps1);
       HR_i = HR_E1-(((TIMEi-temps1)/(temps2-temps1))*(HR_E1-HR_E2));
       PGWe_i  = HR_i * PVSe_i;
       FINS;
       SI (TIMEi '>' temps2);
       PGWe_i  = HR_E2 * PVSe_i;
       FINS;
       SI (TIMEi '>' temps3);
       PGWe_i  = 1300.;
       FINS;
    RGWi    = FGPGW0 * PGWe_i ;
    PRO_RGW = PRO_RGW ET (PROG RGWi);
    N1 = N1 + 1;
FIN BOU_RGW;
EVPC1   = 'EVOL' 'MANU' LTP_TOT  PRO_RGW;
*DESS EVPC1;
CHPC1   = 'MANU' 'CHPO' CONTH_V  1  'SCAL'  1. 'NATURE' 'DISCRETE';
CGPC1   = 'CHAR' 'TECO' CHPC1    EVPC1 ;
*---------------------------------------------------------------------*

*---------------------------------------------------------------------*
*VI. Resolution PASAPAS : Jeune-age (sealed)
*---------------------------------------------------------------------*
TAB0                         = 'TABL' ;
TAB0 . 'MODELE'              = MOD_TOT ;
TAB0 . 'CARACTERISTIQUES'    = MAT_TOT ;
TAB0 . 'BLOCAGES_THERMIQUES' = CLPGT ;
TAB0 . 'CHARGEMENT'          = CGPG1 ET CGPG2 ET CGTK1 ET CGTK2;
TAB0 . 'TEMPS_CALCULES'      = LTP_HYDR ;
TAB0 . 'TEMPS_SAUVES'        = LSA_HYDR ;
TAB0 . 'PROCEDURE_THERMIQUE' = 'NONLINEAIRE' ;
TAB0 . 'RELAXATION_THETA'    = 0.57 ;
TAB0 . 'PRECISION_THERMIQUE' = 5.E-4; 
TAB0 . 'MOVA'                = 'D' ;

*--Convection de la vapeur (gerée par la procedure CHARTHM)--*
TAB0 . 'MO_CONVECTION_VAPEUR'     = TABLE;
TAB0 . 'MO_CONVECTION_VAPEUR' . 1 = MODCOH ;
TAB0 . 'MA_CONVECTION_VAPEUR'     = TABLE  ;
TAB0 . 'MA_CONVECTION_VAPEUR' . 1 = MATCOH ;
TAB0 . 'CH_CONVECTION_VAPEUR'     = TABLE  ; 
TAB0 . 'CH_CONVECTION_VAPEUR' . 1 = CGPC1  ;
*---------------------------------------------------------------------*
TAB0 . 'THM_PARAMETRES'      = MATTHC ;
TAB0 . 'TEMPERATURES'        = 'TABL' ;
TAB0 . 'TEMPERATURES' . 0    = CI_TH ;
TAB0 . 'HYDRATATION'         = 'TABL' ;
TAB0 . 'HYDRATATION' .  0    = MANU CHML MODTHC 'SCAL' HY_0;
TAB0 . 'DCH'                 = 'TABL' ;
TAB0 . 'DCH' .  0            = MANU CHML MODTHC 'SCAL' HY_0;
*---------------------------------------------------------------------*
PASAPAS TAB0;

*---------------------------------------------------------------------*
* DRYING AND AGING
*---------------------------------------------------------------------*
MATCOH  = 'MATE' MODCOH   'H'  0.002;

* Reprise du calcul
TAB0 . 'MA_CONVECTION_VAPEUR' . 1 = MATCOH ;
TAB0 . 'TEMPS_CALCULES'           = LTP_AGIN ;
TAB0 . 'TEMPS_SAUVES'             = LSA_AGIN ;
PASAPAS TAB0;
*---------------------------------------------------------------------*

* --- Check hydration degree at end of aging ---
N_END = (DIME TAB0.'HYDRATATION') - 1;
HY_END = TAB0.'HYDRATATION'.N_END;
MESS '=== HYDRATION DEGREE AT END OF AGING ===';
MESS 'Min HY = ' (MINI HY_END);
MESS 'Max HY = ' (MAXI HY_END);

*---------------------------------------------------------------------*
opti SAUV 'EXAMPLE1D_HAA1_2024_PHASE1';
SAUV;
*---------------------------------------------------------------------*

*---------------------------------------------------------------------*
opti REST 'EXAMPLE1D_HAA1_2024_PHASE1';
REST;
*---------------------------------------------------------------------*

OPTI ECHO 0;
*list (DIME  TAB0 . 'TEMPERATURES');
*list TAB0 . 'TEMPS';

*---------------------------------------------------------------------*
* ACCIDENT
*---------------------------------------------------------------------*
*---------------------------------------------------------------------*
DEBP PARATHER ;
  'ARGUMENT' TABTHER*'TABLE' INST*'FLOTTANT' ;
* (FRA) TABTHER est la table d'entree de PASAPAS
*       INST est l'instant courant de calcul
* (ENG) TABTHER is the input table of the PASAPAS procedur
*       INST is the current calculation time
 
* (FRA) Le chargement doit etre mis a jour dans TABTHER.'WTABLE' !
* (ENG) The loading must be updated in the TABTHER.'WTABLE' table !
* (FRA) L'indice 'THER_COURANT' contient le champ de temperatures de
*       l'iteration courante. Le chargement est mis a jour pour avoir
*       TS = T sur le tube.
* (ENG) The 'THER_COURANT' indice is containing the current iteration
*       temperature field. The loading is updated to have TS = T.

*'MESS' 'ENTRA PARATHER';

WTABLE = TABTHER .'WTABLE' ;

SI (INST '>' temps3);
   MATCOT1  = 'MATE' MODCOT1   'H'     8.  ;
   MATCOT2 = 'MATE' MODCOT2 'H'    8.3;
   MATRAY  = 'MATE' MODRAY   'EMIS'   0.85  ;
   WTABLE.'MAT_TOT' = MATTHC et MATCOT1 et MATRAY et MATCOT2; 
FINS;

FINP;
*---------------------------------------------------------------------*

MATCOH  = 'MATE' MODCOH   'H'     0.018 ;

* Reprise du calcul
TAB0 . 'PROCEDURE_PARATHER'    = VRAI ;
TAB0 . 'CONVECTION_VAPEUR'        = 2 ;
TAB0 . 'MA_CONVECTION_VAPEUR' . 1 = MATCOH ;
TAB0 . 'TEMPS_CALCULES'           = LTP_ACCI ;
TAB0 . 'TEMPS_SAUVES'             = LSA_ACCI ;
PASAPAS TAB0;
*---------------------------------------------------------------------*

*---------------------------------------------------------------------*
* SAVE RESULTS
*---------------------------------------------------------------------*
opti SAUV 'EXAMPLE1D_HAA1_2024_PHASE2';
SAUV ;
*---------------------------------------------------------------------*

*---------------------------------------------------------------------*
* VISULAIZATION OF RESULTS
*---------------------------------------------------------------------*
opti REST 'EXAMPLE1D_HAA1_2024_PHASE2';
REST ;
*---------------------------------------------------------------------*
OPTI ECHO 0;

NTOT = DIME TAB0.'TEMPERATURES';
MESS '--- Total saved steps = ' NTOT;
T_FIRST = TAB0.'TEMPS'. 0;
T_LAST  = TAB0.'TEMPS'. (NTOT - 1);
MESS 'First time = ' T_FIRST ' s';
MESS 'Last time  = ' T_LAST  ' s';
MESS '--- Reference times ---';
MESS 'temps1 (end hydration) = ' temps1 ' s = ' (temps1 / 86400.) ' days';
MESS 'temps3 (end aging)     = ' temps3 ' s = ' (temps3 / 86400.) ' days';
MESS 'temps4 (end accident)  = ' temps4 ' s = ' (temps4 / 86400.) ' days';

CHMT = EXCO 'T' TAB0 . 'TEMPERATURES' . (NTOT - 1);
*TRAC CHMT MODTHC MAIL1;
CHPG = EXCO 'PG' TAB0 . 'TEMPERATURES' . (NTOT - 1);
*TRAC CHPG MODTHC MAIL1;

CHMT = EXCO TAB0.'TEMPERATURES'.(NTOT - 1) 'T';
MESS 'T max = ' (MAXI CHMT) ' K';
MESS 'T min = ' (MINI CHMT) ' K';


*********** TEMPERATURE ********************************************
EVT_00  = EVOL 'BLAN' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_00;
EVT_10  = EVOL 'BLEU' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_10;
EVT_20  = EVOL 'VERT' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_20;
EVT_30  = EVOL 'ROUG' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_30;
EVT_40  = EVOL 'TURQ' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_40;
EVT_50  = EVOL 'ROSE' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_50;
EVT_120 = EVOL 'JAUN' 'TEMP' TAB0 'TEMPERATURES' 'T'  PO_120;
DESS (EVT_00 ET EVT_10 ET EVT_20 ET EVT_30 ET
      EVT_40 ET EVT_50 ET EVT_120)
      'XBOR' temps3 temps4;
********************************************************************

*********** GAS PRESSURE *******************************************
EVPG_10  = EVOL 'BLEU' 'TEMP' TAB0 'TEMPERATURES' 'PG' PO_10;
EVPG_20  = EVOL 'VERT' 'TEMP' TAB0 'TEMPERATURES' 'PG' PO_20;
EVPG_30  = EVOL 'ROUG' 'TEMP' TAB0 'TEMPERATURES' 'PG' PO_30;
EVPG_40  = EVOL 'TURQ' 'TEMP' TAB0 'TEMPERATURES' 'PG' PO_40;
EVPG_50  = EVOL 'ROSE' 'TEMP' TAB0 'TEMPERATURES' 'PG' PO_50;
DESS (EVPG_10 ET EVPG_20 ET EVPG_30 ET
      EVPG_40 ET EVPG_50) 
      'XBOR' temps3 temps4;
********************************************************************


* Calcul humidité relative (Loi de Clapeyron) et SW
TAB0 . 'HR' = TABLE;
TAB0 . 'SW' = TABLE;
*
VGA  = MANU CHPO MAIL1 1 'SCAL' a1;
VGB  = MANU CHPO MAIL1 1 'SCAL' b1;
VGC  = MANU CHPO MAIL1 1 'SCAL' c1;
VGHY = MANU CHPO MAIL1 1 'SCAL' gam0; 
*
N1 = 0;
REPETER BOU_HR (DIME  TAB0 . 'TEMPERATURES' );
   CHTKi = EXCO 'T'  TAB0 . 'TEMPERATURES' . N1;
   CHPCi = EXCO 'PC' TAB0 . 'TEMPERATURES' . N1;
   CHPGi = EXCO 'PG' TAB0 . 'TEMPERATURES' . N1;
   HYDRi = CHAN CHPO TAB0 . 'HYDRATATION' . N1  MODTHC;
   CHPVSATi CHPGWSCi RHOGWi XX YY ZZ = @PVSAT CHPGi CHPCi CHTKi;
   SWi = @SATURA CHPCi CHTKi HYDRi VGA VGB VGC VGHY;
   HRi   =   CHPGWSCi * (CHPVSATi**-1);
   TAB0 . 'HR' . N1 = HRi;
   TAB0 . 'SW' . N1 = SWi;
   N1 = N1 + 1;
FIN BOU_HR;


*LIST (DIME TAB0 . 'TEMPERATURES' );