*==============================================================================
*AUTHOR:  Tan Kiet HONG
*DATE:    2026-03-18
*DESCRIPTION: This is a sample nonlinear stationary thermic problem K(T)T=F. 

*GEOMETRY: A rectangular cantilever beam of length 3 m and height 0.5 m.
*BOUNDARY CONDITIONS:
* - Imposed heat flux of 100 W/m² on the right edge (LDROITE).
* - Convection with a coefficient of 100 W/m²K on the top edge (LHAUT) and ambient temperature of 25 °C.
* - The left edge (LGAUCHE) is thermally insulated (no heat flux and has no imposed temperature) and fixed in space (no mechanical displacement).

*INPUTS:
* - KTHERMAL CONDUCTIVITY K: 
*   K = KD*(1+4*(SL*PHI*RHO_L)/((1-PHI)*RHO_S))
*   KD(T)=KD0(1+A_K (T-T0))
*   WITH KD0=2, A_K=0.005, T0=20

*   SL = = 0.2; PHI = 0.18; RHO_L = 1000.; RHO_S = 2500.;

* - CONVECTION COEFFICIENT: HCONVEC = 100.
* - AMBIENT TEMPERATURE: TLIBRE = 25.
* - IMPOSED HEAT FLUX: FLUXIMPOSE = 100.

*OUTPUTS:
* - TEMPERATURE FIELD T
*==============================================================================

*OPTIONS
OPTI ECHO 0;
OPTI 'DIME' 2 'ELEM' QUA4;

* 1) GEOMETRY AND MESH DEFINITION

*GEOMETRY DEFINITION
LONG    = 3.;
HAUT    = 0.5;

*NUMBER OF MESH SEGMENT
NLONG   = 35;
NHAUT   = 5;

*POINTS CREATION
PA      = 0. 0.;
PB      = LONG 0.;
PC      = LONG HAUT;
PD      = 0. HAUT;
*TRAC (PA ET PB ET PC ET PD);

*MESH LINES CREATION
LAB     = DROI NLONG PA PB;
LBC     = DROI NHAUT PB PC;
LCD     = DROI NLONG PC PD;
LDA     = DROI NHAUT PD PA;

*MESH SURFACE CREATION
MAIL1   = DALL LAB LBC LCD LDA;
*TRAC MAIL1;

* 2) PHYSICAL PROBLEM DEFINITION

*LINE DEFINITION FOR APPLYING BOUNDARY CONDITIONS
LHAUT    = LCD;
LBAS     = LAB;
LDROITE  = LBC;
LGAUCHE  = LDA;

*MODEL DEFINITION
MOD1     = MODE MAIL1 THERMIQUE ISOTROPE;
MOD2     = MODE LHAUT THERMIQUE CONVECTION;
MOD_TOT  = MOD1 ET MOD2;

*MATERIAL PROPERTY DEFINITION
A_K     = 0.005;
T0      = 20.;

SL      = 0.2;
PHI     = 0.18;
RHO_L   = 1000.;
RHO_S   = 2500.;

HCONVEC  = 100.;
TLIBRE   = 25.;
FLUXIMPOSE = 100.;

*RANDOM LOGNORMAL FIELD FOR KD0
*    Mean(KD0) = 2, Std(KD0) = 0.5
LC       = 0.5;
KD0MOYENNE = 2.;
KSIGMA   = 0.2;
KD0CV      = KSIGMA / KD0MOYENNE;

GVAR     = LOG (1. + KD0CV**2);
GSIGMA   = GVAR ** (0.5);
GMOYENNE = LOG (KD0MOYENNE) - 0.5 * GVAR;

* Generate Gaussian random field, then transform to lognormal
GFIELD   = ALEA MOD1 'BANDES_TOURNANTES' EXPO 'SIGMA' GSIGMA 'MOYENNE' GMOYENNE 'LAMBDA' LC;
KD0FIELD = EXP GFIELD;
TRAC KD0FIELD MOD1 MAIL1 'TITR' 'Random field KD0';

*--- CONDUCTIVITY K(T) CALCULATION ---
* Formula: K(T) = KD(T) * [1 + 4 * (SL * PHI * RHO_L) / ((1 - PHI) * RHO_S)]
* KD(T)=KD0(1+A_K (T-T0))
* Range: T = 0 to 100 with a step of 1

* 2) ĐỊNH NGHĨA BIỂU ĐỒ HỆ SỐ NHÂN (CHỈ CHỨA PHẦN BIẾN THIÊN NHIỆT ĐỘ)
*==============================================================================
* Tính FEAU (Hệ số pha lỏng - hằng số)
NUMER = SL * PHI * RHO_L ;
DENOM = (1. - PHI) * RHO_S ;
VAL_FEAU = 1. + (4. * (NUMER / DENOM)) ;

*==============================================================================
* MULTI-ZONE: MỖI ELEMENT CÓ EVOL RIÊNG
*==============================================================================
* Convert MCHAML -> CHPOINT
KD0_CHPO = CHAN 'CHPO' MOD1 KD0FIELD;
MESS 'KD0 min =' (MINI KD0_CHPO) ' max =' (MAXI KD0_CHPO);

NBELEM = NBEL MAIL1;
MESS 'Number of elements:' NBELEM;

* Danh sách nhiệt độ
tXT  = PROG 0. PAS 1. 150.;
NTXT = DIME tXT;

* --- Element 1 ---
MAIL_i = ELEM MAIL1 1;
MOD_i  = MODE MAIL_i THERMIQUE ISOTROPE;
PT_i   = MAIL_i POIN 1;
KD0_i  = EXTR KD0_CHPO 'SCAL' PT_i;

* Xây PROG bằng cách tính giá trị đầu tiên trước vòng lặp
tTi   = EXTR tXT 1;
fT    = 1. + (A_K * (tTi - 20.));
SI (fT < 0.01); fT = 0.01; FINSI;
tKi   = KD0_i * fT * VAL_FEAU;
tYK_i = PROG tKi;

* Nối thêm từ index 2
SI (NTXT > 1);
  REPE BK (NTXT - 1);
    ind   = &BK + 1;
    tTi   = EXTR tXT ind;
    fT    = 1. + (A_K * (tTi - 20.));
    SI (fT < 0.01); fT = 0.01; FINSI;
    tKi   = KD0_i * fT * VAL_FEAU;
    tYK_i = tYK_i ET (PROG tKi);
  FIN BK;
FINSI;

KEVOL_i = EVOL MANU 'T' tXT 'K' tYK_i;
MAT_i   = MATE MOD_i 'K' KEVOL_i;

MOD_CUMUL = MOD_i;
MAT_CUMUL = MAT_i;

* --- Elements 2 → N ---
SI (NBELEM > 1);
  REPE BELEM (NBELEM - 1);
    ii     = &BELEM + 1;
    MAIL_i = ELEM MAIL1 ii;
    MOD_i  = MODE MAIL_i THERMIQUE ISOTROPE;
    PT_i   = MAIL_i POIN 1;
    KD0_i  = EXTR KD0_CHPO 'SCAL' PT_i;

    tTi   = EXTR tXT 1;
    fT    = 1. + (A_K * (tTi - 20.));
    SI (fT < 0.01); fT = 0.01; FINSI;
    tKi   = KD0_i * fT * VAL_FEAU;
    tYK_i = PROG tKi;

    SI (NTXT > 1);
      REPE BK2 (NTXT - 1);
        ind   = &BK2 + 1;
        tTi   = EXTR tXT ind;
        fT    = 1. + (A_K * (tTi - 20.));
        SI (fT < 0.01); fT = 0.01; FINSI;
        tKi   = KD0_i * fT * VAL_FEAU;
        tYK_i = tYK_i ET (PROG tKi);
      FIN BK2;
    FINSI;

    KEVOL_i = EVOL MANU 'T' tXT 'K' tYK_i;
    MAT_i   = MATE MOD_i 'K' KEVOL_i;

    MOD_CUMUL = MOD_CUMUL ET MOD_i;
    MAT_CUMUL = MAT_CUMUL ET MAT_i;
  FIN BELEM;
FINSI;

*==============================================================================
* ADD CONVECTION + ASSEMBLE
*==============================================================================
MAT2    = MATE MOD2 'H' HCONVEC;
MOD_TOT = MOD_CUMUL ET MOD2;
MAT_TOT = MAT_CUMUL ET MAT2;


*TIME DISCRETIZATION (pseudo-transient to reach steady-state)
*TIME FINAL 1000 with time step of 100
TFIN    = 1000.;
LTEMPS1 = PROG 0. PAS 100. TFIN;

* INITIAL CONDITION (for every mesh node at initital temperature and Imposed lbas at Timpose)
T_INI   = T0;
T0_CHPO = MANU 'CHPO' MAIL1 'T' T_INI;

* 3) RESOLUTION (PASAPAS NONLINEAR SOLVER)

*IMPOSED HEAT FLUX on LDROITE 
EV_FLUX = EVOL MANU 'TEMPS' (PROG 0. TFIN) 'T' (PROG 1. 1.);
FLT2_0  = FLUX MOD1 LDROITE FLUXIMPOSE;
FLT2    = CHAR 'Q' FLT2_0 EV_FLUX;
*CONVECTION LOAD VECTOR on LHAUT
CONV1   = MANU 'CHPO' LHAUT 1 'T' TLIBRE 'NATURE' 'DISCRETE';
EV_CONV = EVOL MANU 'TEMPS' (PROG 0. TFIN) 'T' (PROG 1. 1.);
CHAR_CV = CHAR 'TECO' CONV1 EV_CONV;

*RESOLUTION PASAPAS (nonlinear thermal)
TAB1 = TABLE;
TAB1.TEMPERATURES        = TABLE;
TAB1.TEMPERATURES.0      = T0_CHPO;
TAB1.MODELE              = MOD_TOT;
TAB1.CARACTERISTIQUES    = MAT_TOT;
TAB1.CHARGEMENT          = FLT2 ET CHAR_CV;
TAB1.PROCEDURE_THERMIQUE = NONLINEAIRE;
TAB1.RELAXATION_THETA    = 0.57;
TAB1.TEMPS_CALCULES      = LTEMPS1;

PASAPAS TAB1;

*VISUALIZATION
NBT  = DIME TAB1.TEMPERATURES;
TRES = TAB1.TEMPERATURES.(NBT - 1);
TRAC TRES MAIL1;