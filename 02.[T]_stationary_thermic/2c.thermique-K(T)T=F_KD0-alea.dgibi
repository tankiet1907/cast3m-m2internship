*==============================================================================
*AUTHOR:  Tan Kiet HONG
*DATE:    2026-03-18
*DESCRIPTION: This is a sample of a nonlinear stationary thermic problem K(T)T=F developed from code 2b, with a random field of KD0. 

*To build the condutivity matrix K(x,y,T) that depend on space and the state variable T, the code using a multi-zone approach, which is to extract KD0 then K(x,y) of i element and combine with the evolution of K(T) to create a K(x,y,T)_i (or MATE_i) then assemble the global matrix K from K_i (MATE_total).

*GEOMETRY: A rectangular cantilever beam of length 3 m and height 0.5 m.
*BOUNDARY CONDITIONS:
* - Imposed heat flux of 100 W/m² on the right edge (LDROITE).
* - Convection with a coefficient of 100 W/m²K on the top edge (LHAUT) and ambient temperature of 25 °C.
* - The left edge (LGAUCHE) is thermally insulated (no heat flux and has no imposed temperature) and fixed in space (no mechanical displacement).

*INPUTS:
* - KTHERMAL CONDUCTIVITY K: 
*   K = KD*(1+4*(SL*PHI*RHO_L)/((1-PHI)*RHO_S))
*   KD(T)=KD0(1+A_K (T-T0))
*   WITH KD0=2, A_K=0.005, T0=20

*   SL = 0.2; PHI = 0.18; RHO_L = 1000.; RHO_S = 2500.;

* - CONVECTION COEFFICIENT: HCONVEC = 100.
* - AMBIENT TEMPERATURE: TLIBRE = 25.
* - IMPOSED HEAT FLUX: FLUXIMPOSE = 100.

*OUTPUTS:
* - TEMPERATURE FIELD T
*==============================================================================

*OPTIONS
OPTI ECHO 0;
OPTI 'DIME' 2 'ELEM' QUA4;

*==============================================================================
* 1) GEOMETRY AND MESH DEFINITION

*GEOMETRY DEFINITION
LONG    = 3.;
HAUT    = 0.5;

*NUMBER OF MESH SEGMENT
NLONG   = 35;
NHAUT   = 5;

*POINTS CREATION
PA      = 0. 0.;
PB      = LONG 0.;
PC      = LONG HAUT;
PD      = 0. HAUT;
*TRAC (PA ET PB ET PC ET PD);

*MESH LINES CREATION
LAB     = DROI NLONG PA PB;
LBC     = DROI NHAUT PB PC;
LCD     = DROI NLONG PC PD;
LDA     = DROI NHAUT PD PA;

*MESH SURFACE CREATION
MAIL1   = DALL LAB LBC LCD LDA;
*TRAC MAIL1;

*==============================================================================
* 2) PHYSICAL PROBLEM DEFINITION

*LINE DEFINITION FOR APPLYING BOUNDARY CONDITIONS
LHAUT    = LCD;
LBAS     = LAB;
LDROITE  = LBC;
LGAUCHE  = LDA;

*MODEL DEFINITION
MOD1     = MODE MAIL1 THERMIQUE ISOTROPE;
MOD2     = MODE LHAUT THERMIQUE CONVECTION;

*MATERIAL PROPERTY DEFINITION
A_K     = 0.005;
T0      = 20.;

SL      = 0.2;
PHI     = 0.18;
RHO_L   = 1000.;
RHO_S   = 2500.;

HCONVEC  = 100.;
TLIBRE   = 25.;
FLUXIMPOSE = 100.;

*==============================================================================
* 2A) RANDOM LOGNORMAL FIELD FOR KD0
*    Mean(KD0) = 2, Std(KD0) = 0.5
LC       = 0.1;
KD0MOYENNE = 2.;
KSIGMA   = 0.1;
KD0CV      = KSIGMA / KD0MOYENNE;

GVAR     = LOG (1. + KD0CV**2);
GSIGMA   = GVAR ** (0.5);
GMOYENNE = LOG (KD0MOYENNE) - 0.5 * GVAR;

* Generate Gaussian random field, then transform to lognormal
GFIELD   = ALEA MOD1 'BANDES_TOURNANTES' EXPO 'SIGMA' GSIGMA 'MOYENNE' GMOYENNE 'LAMBDA' LC;
KD0FIELD = EXP GFIELD;
TRAC KD0FIELD MOD1 MAIL1 'TITR' 'Random field KD0';

*==============================================================================
* 2B) CONDUCTIVITY K(x,y,T) CALCULATION
* Formula: K(T) = KD(T) * [1 + 4 * (SL * PHI * RHO_L) / ((1 - PHI) * RHO_S)]
* KD(T)=KD0(1+A_K (T-T0))
* Range: T = 0 to 100 with a step of 1

* Step-by-step calculation of the liquid phase multiplier (FEAU) to ensure mathematical operator priority in Cast3M
* FEAU = [1 + 4 * (SL * PHI * RHO_L) / ((1 - PHI) * RHO_S)]
temps1    = SL * PHI * RHO_L;
temps2  = (1. - PHI) * RHO_S;
FEAU    = 1. + (4. * temps1 / temps2);

*==============================================================================
* MULTI-ZONE APPROACH
* Purpose: Create element-wise thermal models with spatially varying
*          conductivity K(x,y,T) = KD0(x,y) * (1 + A_K*(T-T0)) * FEAU
*          Each element gets its own K(T) curve (EVOL) with unique KD0 value
*          from the random field, enabling spatial heterogeneity

* Convert random field from element-based (MCHAML) to node-based (CHPOINT) so we can extract scalar values at individual nodes
KD0_CHPO = CHAN 'CHPO' MOD1 KD0FIELD;
MESS 'KD0 min =' (MINI KD0_CHPO) ' max =' (MAXI KD0_CHPO);

* Get total number of elements in the mesh
NBELEM = NBEL MAIL1;
MESS 'Number of elements:' NBELEM;

* Temperature list for building K(T) curves (0° to 150°, step 1°)
tXT  = PROG 0. PAS 1. 150.;
NTXT = DIME tXT;

*==============================================================================
* ELEMENT 1: Initialize MOD_CUMUL and MAT_CUMUL
* Treated separately because Cast3M cannot create empty MODEL/MATERIAL object
MAIL_i = ELEM MAIL1 1;
MOD_i  = MODE MAIL_i THERMIQUE ISOTROPE;
* Extract KD0 value at first node of this element from the random field
PT_i   = MAIL_i POIN 1;
KD0_i  = EXTR KD0_CHPO 'SCAL' PT_i;

* Build K(T) curve for element 1:  K(T) = KD0_i * (1 + A_K*(T-T0)) * FEAU
* First temperature point (T=0°C) computed outside loop
* because Cast3M cannot create an empty PROG list
tTi   = EXTR tXT 1;
fT    = 1. + (A_K * (tTi - 20.));
SI (fT < 0.01); fT = 0.01; FINSI;
tKi   = KD0_i * fT * FEAU;
tYK_i = PROG tKi;

* Append remaining temperature points (T=1°C to 150°C) to K(T) curve
SI (NTXT > 1);
  REPE BK (NTXT - 1);
    ind   = &BK + 1;
    tTi   = EXTR tXT ind;
    fT    = 1. + (A_K * (tTi - 20.));
    SI (fT < 0.01); fT = 0.01; FINSI;
    tKi   = KD0_i * fT * FEAU;
    tYK_i = tYK_i ET (PROG tKi);
  FIN BK;
FINSI;

* Create K vs T evolution curve and assign to element 1 material
KEVOL_i = EVOL MANU 'T' tXT 'K' tYK_i;
MAT_i   = MATE MOD_i 'K' KEVOL_i;

* Initialize accumulators with element 1
* (subsequent elements will be appended with ET operator)
MOD_CUMUL = MOD_i;
MAT_CUMUL = MAT_i;

*==============================================================================
* ElEMENT 2 to N
* Same logic as element 1, but results are appended to accumulators

SI (NBELEM > 1);
  REPE BELEM (NBELEM - 1);
    ii     = &BELEM + 1;
* Extract element ii mesh and create its individual thermal model
    MAIL_i = ELEM MAIL1 ii;
    MOD_i  = MODE MAIL_i THERMIQUE ISOTROPE;
* Get KD0 value for element ii from the random field
    PT_i   = MAIL_i POIN 1;
    KD0_i  = EXTR KD0_CHPO 'SCAL' PT_i;

* Build K(T) curve for element ii: K(T) = KD0_i * (1 + A_K*(T-20)) * FEAU
* First temperature point (T=0°C) — initialize PROG list
    tTi   = EXTR tXT 1;
    fT    = 1. + (A_K * (tTi - 20.));
    SI (fT < 0.01); fT = 0.01; FINSI;
    tKi   = KD0_i * fT * FEAU;
    tYK_i = PROG tKi;

* Append remaining temperature points (T=1°C to 150°C)
    SI (NTXT > 1);
      REPE BK2 (NTXT - 1);
        ind   = &BK2 + 1;
        tTi   = EXTR tXT ind;
        fT    = 1. + (A_K * (tTi - 20.));
        SI (fT < 0.01); fT = 0.01; FINSI;
        tKi   = KD0_i * fT * FEAU;
        tYK_i = tYK_i ET (PROG tKi);
      FIN BK2;
    FINSI;

* Create K vs T evolution curve and assign to element ii material
    KEVOL_i = EVOL MANU 'T' tXT 'K' tYK_i;
    MAT_i   = MATE MOD_i 'K' KEVOL_i;

* Accumulate: append element ii model and material to global objects
    MOD_CUMUL = MOD_CUMUL ET MOD_i;
    MAT_CUMUL = MAT_CUMUL ET MAT_i;
  FIN BELEM;
FINSI;

*==============================================================================
* MATERIAL DEFINITION
* MOD_CUMUL and MAT_CUMUL to replace MOD1 and MAT1
*   PASAPAS will automatically look up the correct EVOL for each element during nonlinear iterations

MAT2    = MATE MOD2 'H' HCONVEC;
MOD_TOT = MOD_CUMUL ET MOD2;
MAT_TOT = MAT_CUMUL ET MAT2;

*==============================================================================
* 2C) TIME DISCRETIZATION
* Pseudo-transient: PASAPAS requires time steps even for steady-state problems
* TFIN and dt are artificial — only the final converged state matters
TFIN    = 1000.;
LTEMPS1 = PROG 0. PAS 100. TFIN;

* INITIAL CONDITION (for every mesh node at initital temperature)
T_INI   = T0;
T0_CHPO = MANU 'CHPO' MAIL1 'T' T_INI;

*==============================================================================
* 3) RESOLUTION (PASAPAS NONLINEAR SOLVER)

*IMPOSED HEAT FLUX on LDROITE 
EV_FLUX = EVOL MANU 'TEMPS' (PROG 0. TFIN) 'T' (PROG 1. 1.);
FLT2_0  = FLUX MOD1 LDROITE FLUXIMPOSE;
FLT2    = CHAR 'Q' FLT2_0 EV_FLUX;
*CONVECTION LOAD VECTOR on LHAUT
CONV1   = MANU 'CHPO' LHAUT 1 'T' TLIBRE 'NATURE' 'DISCRETE';
EV_CONV = EVOL MANU 'TEMPS' (PROG 0. TFIN) 'T' (PROG 1. 1.);
CHAR_CV = CHAR 'TECO' CONV1 EV_CONV;

*RESOLUTION PASAPAS (nonlinear thermal)
TAB1 = TABLE;
TAB1.TEMPERATURES        = TABLE;
TAB1.TEMPERATURES.0      = T0_CHPO;
TAB1.MODELE              = MOD_TOT;
TAB1.CARACTERISTIQUES    = MAT_TOT;
TAB1.CHARGEMENT          = FLT2 ET CHAR_CV;
TAB1.PROCEDURE_THERMIQUE = NONLINEAIRE;
TAB1.RELAXATION_THETA    = 0.57;
TAB1.TEMPS_CALCULES      = LTEMPS1;

PASAPAS TAB1;

*VISUALIZATION
NBT  = DIME TAB1.TEMPERATURES;
TRES = TAB1.TEMPERATURES.(NBT - 1);
TRAC TRES MAIL1;