{
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "%DOCFILE%"
      ]
    },
    {
      "name": "makeindex",
      "command": "makeindex",
      "args": [
        "%DOCFILE%.nlo",
        "-s",
        "nomencl.ist",
        "-o",
        "%DOCFILE%.nls"
      ]
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex → biber → makeindex → pdflatex ×2",
      "tools": [
        "pdflatex",
        "biber",
        "makeindex",
        "pdflatex",
        "pdflatex"
      ]
    }
  ],

  "latex-workshop.latex.recipe.default": "pdflatex → biber → makeindex → pdflatex ×2"
}