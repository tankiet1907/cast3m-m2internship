\nomgroup{M}
  \item [{$\boldsymbol{\sigma}$}]\begingroup Cauchy stress tensor \nomunit{Pa}\nomeqref {0}\nompageref{ii}
  \item [{$\boldsymbol{\varepsilon}$}]\begingroup Total strain tensor \nomunit{-}\nomeqref {0}\nompageref{ii}
  \item [{$\boldsymbol{\varepsilon}_e$}]\begingroup Elastic strain tensor \nomunit{-}\nomeqref {0}\nompageref{ii}
  \item [{$\boldsymbol{\varepsilon}_{th}$}]\begingroup Thermal strain \nomunit{-}\nomeqref {0}\nompageref{ii}
  \item [{$D$}]\begingroup Damage variable \nomunit{-}\nomeqref {0}\nompageref{ii}
  \item [{$E$}]\begingroup Young's modulus \nomunit{Pa}\nomeqref {0}\nompageref{ii}
  \item [{$f_t$}]\begingroup Tensile strength \nomunit{Pa}\nomeqref {0}\nompageref{ii}
  \item [{$G_f$}]\begingroup Fracture energy \nomunit{J$\cdot$m$^{-2}$}\nomeqref {0}\nompageref{ii}
  \item [{$L_e$}]\begingroup Characteristic element length \nomunit{m}\nomeqref {0}\nompageref{ii}
\nomgroup{T}
  \item [{$\lambda$}]\begingroup Thermal conductivity \nomunit{W$\cdot$m$^{-1}$$\cdot$K$^{-1}$}\nomeqref {0}\nompageref{ii}
  \item [{$\rho$}]\begingroup Mass density \nomunit{kg$\cdot$m$^{-3}$}\nomeqref {0}\nompageref{ii}
  \item [{$\sigma$}]\begingroup Stefan--Boltzmann constant \nomunit{W$\cdot$m$^{-2}$$\cdot$K$^{-4}$}\nomeqref {0}\nompageref{ii}
  \item [{$\varepsilon$}]\begingroup Emissivity \nomunit{-}\nomeqref {0}\nompageref{ii}
  \item [{$c_p$}]\begingroup Specific heat capacity \nomunit{J$\cdot$kg$^{-1}$$\cdot$K$^{-1}$}\nomeqref {0}\nompageref{ii}
  \item [{$h$}]\begingroup Convective heat transfer coefficient \nomunit{W$\cdot$m$^{-2}$$\cdot$K$^{-1}$}\nomeqref {0}\nompageref{ii}
