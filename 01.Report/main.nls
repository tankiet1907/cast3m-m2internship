  \item [{$[C]$}]\begingroup Capacity matrix \nomunit{}\nomeqref {0}\nompageref{ii}
  \item [{$[K]$}]\begingroup Global stiffness matrix \nomunit{}\nomeqref {0}\nompageref{ii}
  \item [{$\{F\}$}]\begingroup Nodal force vector \nomunit{}\nomeqref {0}\nompageref{ii}
  \item [{$\{R\}$}]\begingroup Residual vector \nomunit{}\nomeqref {0}\nompageref{ii}
