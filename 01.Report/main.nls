  \item [{$T$}]\begingroup Temperature \nomunit{K}\nomeqref {0}\nompageref{iii}
  \item [{$T_0$}]\begingroup Reference temperature \nomunit{K}\nomeqref {0}\nompageref{iii}
  \item [{$T_{crit}$}]\begingroup Critical temperature of water (647 K) \nomunit{K}\nomeqref {0}\nompageref{iii}
\nomgroup{C}
