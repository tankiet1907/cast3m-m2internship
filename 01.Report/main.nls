  \item [{$C_l$}]\begingroup Specific heat capacity of liquid (advection term) \nomunit{J$\cdot$kg$^{-1}$$\cdot$K$^{-1}$}\nomeqref {0}\nompageref{iii}
  \item [{$c_p$}]\begingroup Specific heat capacity \nomunit{J$\cdot$kg$^{-1}$$\cdot$K$^{-1}$}\nomeqref {0}\nompageref{iii}
  \item [{$C_{pa}$}]\begingroup Specific heat capacity of dry air \nomunit{J$\cdot$kg$^{-1}$$\cdot$K$^{-1}$}\nomeqref {0}\nompageref{iii}
  \item [{$C_{pl}$}]\begingroup Specific heat capacity of liquid water \nomunit{J$\cdot$kg$^{-1}$$\cdot$K$^{-1}$}\nomeqref {0}\nompageref{iii}
  \item [{$C_{ps}$}]\begingroup Specific heat capacity of the solid skeleton \nomunit{J$\cdot$kg$^{-1}$$\cdot$K$^{-1}$}\nomeqref {0}\nompageref{iii}
  \item [{$C_{pv}$}]\begingroup Specific heat capacity of water vapor \nomunit{J$\cdot$kg$^{-1}$$\cdot$K$^{-1}$}\nomeqref {0}\nompageref{iii}
