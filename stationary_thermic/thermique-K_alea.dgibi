*OPTIONS
OPTI ECHO 0;
OPTI 'DIME' 2 'ELEM' QUA4;

* 1) GEOMETRY AND MESH DEFINITION

*GEOMETRY DEFINITION
LONG    = 3.;
HAUT    = 0.5;

*NUMBER OF MESH SEGMENT
NLONG   = 35;
NHAUT   = 5;

*POINTS CREATION
PA      = 0. 0.;
PB      = LONG 0.;
PC      = LONG HAUT;
PD      = 0. HAUT;

*MESH LINES CREATION
LAB     = DROI NLONG PA PB;
LBC     = DROI NHAUT PB PC;
LCD     = DROI NLONG PC PD;
LDA     = DROI NHAUT PD PA;

*MESH SURFACE CREATION
MAIL1   = DALL LAB LBC LCD LDA;
*TRAC MAIL1;

* 2) PHYSICAL PROBLEM DEFINITION

*LINE DEFINITION FOR APPLYING BOUNDARY CONDITIONS
LHAUT    = LCD;
LBAS     = LAB;
LDROITE  = LBC;
LGAUCHE  = LDA;

*MATHEMATIC PROBLEM DEFINITION
MOD1     = MODE MAIL1 THERMIQUE ISOTROPE;
MOD2     = MODE LHAUT THERMIQUE CONVECTION;

* =================================================================
* THÊM YẾU TỐ ALEA CHO HỆ SỐ DẪN NHIỆT K
* =================================================================
* Định nghĩa các tham số thống kê cho K (Phân phối Lognormal)
K1       = 1.0;       
SG_K     = 0.2;       
b        = 0.1;       

* Chuyển đổi từ phân phối Lognormal sang Normal để dùng hàm ALEA
ae       = SG_K / K1;
aae      = (1. + (ae * ae))**(0.5);
Kg       = LOG (K1 / aae);         
S1       = LOG (1. + (ae * ae));
S2       = S1 ** (0.5);            

* Tạo trường ngẫu nhiên phân phối chuẩn bằng hàm ALEA
CH00     = ALEA MOD1 'BANDES_TOURNANTES' EXPO 'SIGMA' S2 'MOYENNE' Kg 'LAMBDA' b;

* Chuyển ngược lại thành phân phối Lognormal (đảm bảo K > 0)
CHA_K    = EXP CH00;

* (Tùy chọn) Vẽ trường K ngẫu nhiên để kiểm tra
TRAC CHA_K MOD1 MAIL1 'TITR' 'Truong he so dan nhiet K ngau nhien';
* =================================================================

*MATERIAL PROPERTY DEFINITION
HCONVEC  = 100.;
TLIBRE   = 25.;
TIMPOSE  = 200.;
FLUXIMPOSE = 100.;

* Gán trường ngẫu nhiên CHA_K vào thuộc tính 'K' thay vì hằng số
MAT1     = MATE MOD1 'K' CHA_K;
MAT2     = MATE MOD2 'H' HCONVEC;

* 3) RESOLUTION

*THERMAL BOUNDARY CONDITIONS DEFINITION
*CONDUCTIVITY MATRIX K ASSEMBLY
CND1     = COND MOD1 MAT1;
CND2     = COND MOD2 MAT2;

*IMPOSED TEMPERATURE
BB1     = BLOQ LBAS 'T';
FLT1    = DEPI BB1 TIMPOSE;

*IMPOSED HEAT FLUX
FLT2    = FLUX MOD1 LDROITE FLUXIMPOSE;

*CONVECTION LOAD VECTOR
CNV1    = CONVECTION MOD2 MAT2 'T' TLIBRE;

*RESOLUTION OF THE SYSTEM T
KKKK    = CND1 ET CND2 ET BB1;
FFFF    = FLT1 ET FLT2 ET CNV1;
TTTT    = RESO KKKK FFFF;

* Vẽ trường nhiệt độ kết quả
TRAC TTTT MAIL1 'TITR' 'Truong nhiet do T';